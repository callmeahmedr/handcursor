.idea/

# Secrets and local config
.env
.env.*
*.pem
*.p12
*.key
*.mobileprovision

# Python caches (icon/banner/sound scripts)
__pycache__/
*.pyc
.venv/

# Scratch
*.log
*.tmp
*.swp
assets/unused/
